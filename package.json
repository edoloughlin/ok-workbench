{
  "name": "ok-workbench",
  "version": "1.0.0",
  "description": "A local LLM-assisted workspace for OKF-structured project knowledge.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "ok-workbench": "dist/bin/ok-workbench.mjs",
    "okf-workbench": "dist/bin/ok-workbench.mjs"
  },
  "files": ["dist/", "seed/", "README.md", "LICENSE"],
  "scripts": {
    "build": "npm run docs:sync && node scripts/build.mjs",
    "docs:sync": "node scripts/sync-doc-templates.mjs",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test && npm run pack"
  },
  "engines": { "node": ">=22.19.0" },
  "keywords": ["okf", "workspace", "llm", "project-management"],
  "repository": { "type": "git", "url": "git+https://github.com/edoloughlin/ok-workbench.git" },
  "bugs": { "url": "https://github.com/edoloughlin/ok-workbench/issues" },
  "homepage": "https://edoloughlin.github.io/ok-workbench/",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "typebox": "^1.3.7"
  }
}
